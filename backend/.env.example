# E-Mail-Versand (SMTP)
MAIL_USERNAME=test@test.com
MAIL_PASSWORD=<Your Mail Password>
MAIL_FROM=test@test.com
MAIL_SERVER=localhost
MAIL_PORT=1025
MAIL_STARTTLS=False
MAIL_SSL_TLS=False
MAIL_USE_CREDENTIALS=False

# MQTT-Broker
# Hinweis: Wird beim Betrieb über docker-compose automatisch auf "mosquitto"
# überschrieben (siehe environment: im backend-Service der docker-compose.yml).
# "localhost" gilt nur, wenn das Backend ausserhalb von Docker läuft.
MQTT_BROKER_URL=localhost
MQTT_BROKER_PORT=1883
MQTT_USERNAME=portal_backend
MQTT_PASSWORD=<Your MQTT Password>

# Empfänger für Bestell-/Liefer-Benachrichtigungen
CUSTOMER_EMAIL=customer@example.com

# Frontend-URL (für CORS)
FRONTEND_URL=http://localhost:5173

# Interne API-Absicherung
APS_API_KEY=<Your APS API Key>
DEV_RESET_KEY=<Your DEV Reset Key>
ADMIN_API_KEY=<Your ADMIN API Key>   # muss identisch mit VITE_ADMIN_API_KEY im Frontend sein